<?xml version="1.0"?>

<robot name="husky_ur10" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="ros2_control.xacro"/>

  <!-- UR robot xacro macro (from the universal_robot ROS package) -->
  <xacro:include filename="$(find husky_ur10_cam)/urdf/ur_macro.xacro"/>

  <!-- ================================================================
       UR10 top-level arguments (mirror ur10_cam_urdf.xacro)
  ================================================================ -->
  <xacro:arg name="name"                       default="ur10"/>
  <xacro:arg name="ur_type"                    default="ur10"/>
  <xacro:arg name="tf_prefix"                  default="ur10_"/>
  <xacro:arg name="joint_limit_params"         default="$(find husky_ur10_cam)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"          default="$(find husky_ur10_cam)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"            default="$(find husky_ur10_cam)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"              default="$(find husky_ur10_cam)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface"  default=""/>
  <xacro:arg name="safety_limits"              default="false"/>
  <xacro:arg name="safety_pos_margin"          default="0.15"/>
  <xacro:arg name="safety_k_position"          default="20"/>
  <xacro:arg name="headless_mode"              default="false"/>
  <xacro:arg name="robot_ip"                   default="0.0.0.0"/>
  <xacro:arg name="script_filename"            default=""/>
  <xacro:arg name="output_recipe_filename"     default=""/>
  <xacro:arg name="input_recipe_filename"      default=""/>
  <xacro:arg name="reverse_ip"                 default="0.0.0.0"/>
  <xacro:arg name="script_command_port"        default="50004"/>
  <xacro:arg name="reverse_port"               default="50001"/>
  <xacro:arg name="script_sender_port"         default="50002"/>
  <xacro:arg name="trajectory_port"            default="50003"/>
  <xacro:arg name="use_tool_communication"     default="false"/>
  <xacro:arg name="tool_voltage"               default="0"/>
  <xacro:arg name="tool_parity"                default="0"/>
  <xacro:arg name="tool_baud_rate"             default="115200"/>
  <xacro:arg name="tool_stop_bits"             default="1"/>
  <xacro:arg name="tool_rx_idle_chars"         default="1.5"/>
  <xacro:arg name="tool_tx_idle_chars"         default="3.5"/>
  <xacro:arg name="tool_device_name"           default="/tmp/ttyUR"/>
  <xacro:arg name="tool_tcp_port"              default="54321"/>
  <xacro:arg name="use_fake_hardware"          default="false"/>
  <xacro:arg name="fake_sensor_commands"       default="false"/>
  <xacro:arg name="sim_gazebo"                 default="true"/>
  <xacro:arg name="sim_ignition"               default="false"/>
  <xacro:arg name="simulation_controllers"     default=""/>
  <xacro:arg name="initial_positions_file"     default="$(find husky_ur10_cam)/config/initial_positions.yaml"/>

  <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)"/>
  <xacro:property name="is_sim_gazebo"          value="$(arg sim_gazebo)"/>
  <xacro:property name="is_sim_ignition"        value="$(arg sim_ignition)"/>

  <!-- ================================================================
       Husky chassis dimensions (from custom_husky_urdf.xacro)
  ================================================================ -->
  <xacro:property name="chassis_length"         value="0.85"/>
  <xacro:property name="chassis_width"          value="0.420"/>
  <xacro:property name="chassis_height"         value="0.242"/>
  <xacro:property name="chassis_mass"           value="50.0"/>
  <xacro:property name="wheel_radius"           value="0.160"/>
  <xacro:property name="wheel_thickness"        value="0.139"/>
  <xacro:property name="wheel_mass"             value="2.0"/>
  <xacro:property name="wheel_offset_x"         value="0.226"/>
  <xacro:property name="wheel_offset_y"         value="0.1485"/>
  <xacro:property name="wheel_offset_z"         value="0.01"/>
  <xacro:property name="caster_wheel_radius"    value="0.01"/>
  <xacro:property name="caster_wheel_mass"      value="0.01"/>
  <xacro:property name="caster_wheel_offset_x"  value="0.075"/>
  <xacro:property name="caster_wheel_offset_z"  value="${wheel_offset_z - wheel_radius + caster_wheel_radius}"/>

  <!-- ================================================================
       Materials
  ================================================================ -->
  <material name="white">  <color rgba="1 1 1 1"/>       </material>
  <material name="orange"> <color rgba="1 0.3 0.1 1"/>   </material>
  <material name="blue">   <color rgba="0.2 0.2 1 1"/>   </material>
  <material name="black">  <color rgba="0 0 0 1"/>        </material>
  <material name="red">    <color rgba="1 0 0 1"/>        </material>

  <!-- ================================================================
       HUSKY UGV
  ================================================================ -->

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <!-- Base Link (chassis) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 ${chassis_height/2 + wheel_radius}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- Front Left Wheel -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>
  <gazebo reference="front_left_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.220 ${chassis_width/2 + wheel_thickness/2 + 0.02} -${chassis_height/2}" rpy="-1.57 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
  </joint>

  <!-- Front Right Wheel -->
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>
  <gazebo reference="front_right_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.220 -${chassis_width/2 + wheel_thickness/2 + 0.02} -${chassis_height/2}" rpy="1.57 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 0 -1" rpy="0 0 0"/>
  </joint>

  <!-- Rear Left Wheel -->
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>
  <gazebo reference="rear_left_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.220 ${chassis_width/2 + wheel_thickness/2 + 0.02} -${chassis_height/2}" rpy="-1.57 0 0"/>
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 0 1" rpy="0 0 0"/>
  </joint>

  <!-- Rear Right Wheel -->
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>
  <gazebo reference="rear_right_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.220 -${chassis_width/2 + wheel_thickness/2 + 0.02} -${chassis_height/2}" rpy="1.57 0 0"/>
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 0 -1" rpy="0 0 0"/>
  </joint>

  <!-- Velodyne Mount -->
  <link name="velodyne_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.010" length="0.30"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.010" length="0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.01"/>
    </inertial>
  </link>
  <gazebo reference="velodyne_mount">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="velodyne_mount_joint" type="fixed">
    <origin xyz="0 0 ${chassis_height/2 + 0.15}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="velodyne_mount"/>
  </joint>

  <!-- Velodyne LiDAR -->
  <link name="velodyne">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0"
               iyy="0.05" iyz="0.0"
               izz="0.05"/>
    </inertial>
  </link>
  <gazebo reference="velodyne">
    <material>Gazebo/Red</material>
    <sensor type="gpu_ray" name="velodyne_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_velodyne_controller" filename="libgazebo_ros_velodyne_laser.so">
        <ros>
          <remapping>~/out:=/velodyne_points</remapping>
        </ros>
        <frame_name>velodyne</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <joint name="velodyne_joint" type="fixed">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <parent link="velodyne_mount"/>
    <child link="velodyne"/>
  </joint>

  <!-- Active perception: 4 radially-outward depth cameras at the chassis
       corners, one per direction of the SRDF's front_left/front_right/
       rear_right/rear_left arm anchor poses (husky_ur10_moveit_config/
       srdf/ur.srdf), tilted slightly up so they see over nearby clutter.
       active_perception_node periodically checks all 4 to decide whether
       coverage should pause to search, and if so, in which direction -
       gated to only within max_check_distance_m (default 3m) via each
       one's /points cloud, same as the existing chassis_camera stub
       pattern's depth type. -->
  <xacro:macro name="chassis_corner_camera" params="name x y yaw_deg tilt_up_deg:=15">
    <link name="chassis_cam_${name}_mount">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.005" length="0.10"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.005" length="0.10"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                 iyy="0.01" iyz="0.0"
                 izz="0.01"/>
      </inertial>
    </link>
    <gazebo reference="chassis_cam_${name}_mount">
      <material>Gazebo/White</material>
    </gazebo>
    <joint name="chassis_cam_${name}_mount_joint" type="fixed">
      <origin xyz="${x} ${y} ${chassis_height/2}" rpy="0 0 ${yaw_deg*pi/180}"/>
      <parent link="base_link"/>
      <child link="chassis_cam_${name}_mount"/>
    </joint>

    <link name="chassis_cam_${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.10 0.02"/>
        </geometry>
        <material name="orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.02 0.10 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.05" ixy="0.0" ixz="0.0"
                 iyy="0.05" iyz="0.0"
                 izz="0.05"/>
      </inertial>
    </link>
    <joint name="chassis_cam_${name}_joint" type="fixed">
      <origin xyz="0 0 0.05" rpy="0 -${tilt_up_deg*pi/180} 0"/>
      <parent link="chassis_cam_${name}_mount"/>
      <child link="chassis_cam_${name}"/>
    </joint>

    <link name="chassis_cam_${name}_optical"/>
    <joint name="chassis_cam_${name}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-${pi/2} 0 -${pi/2}"/>
      <parent link="chassis_cam_${name}"/>
      <child link="chassis_cam_${name}_optical"/>
    </joint>

    <gazebo reference="chassis_cam_${name}">
      <material>Gazebo/Orange</material>
      <sensor name="chassis_cam_${name}_sensor" type="depth">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <depth_camera name="chassis_cam_${name}">
          <horizontal_fov>2</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
        <plugin name="chassis_cam_${name}_driver" filename="libgazebo_ros_camera.so">
          <frame_name>chassis_cam_${name}_optical</frame_name>
          <camera_name>chassis_cam_${name}</camera_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:chassis_corner_camera name="front_left"  x="${chassis_length/2 - 0.05}"  y="${chassis_width/2 - 0.03}"  yaw_deg="45"/>
  <xacro:chassis_corner_camera name="front_right" x="${chassis_length/2 - 0.05}"  y="-${chassis_width/2 - 0.03}" yaw_deg="-45"/>
  <xacro:chassis_corner_camera name="rear_left"   x="-${chassis_length/2 - 0.05}" y="${chassis_width/2 - 0.03}"  yaw_deg="135"/>
  <xacro:chassis_corner_camera name="rear_right"  x="-${chassis_length/2 - 0.05}" y="-${chassis_width/2 - 0.03}" yaw_deg="-135"/>

  <!-- IMU -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>imu_plugin/out:=imu/data</remapping>
        </ros>
        <body_name>imu_link</body_name>
        <frame_name>imu_link</frame_name>
        <gaussian_noise>0.01</gaussian_noise>
      </plugin>
    </sensor>
  </gazebo>

  <link name="arm_base_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- A thin aluminium plate: 200 mm × 200 mm × 10 mm -->
        <box size="0.20 0.20 0.01"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.20 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0"
               iyy="0.003" iyz="0.0"
               izz="0.005"/>
    </inertial>
  </link>

  <joint name="arm_base_mount_joint" type="fixed">
    <origin xyz="-${chassis_length/2 - 0.12} 0.0 ${chassis_height/2 + 0.005}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="arm_base_mount"/>
  </joint>

  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="arm_base_mount"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    transmission_hw_interface="$(arg transmission_hw_interface)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"
    sim_gazebo="$(arg sim_gazebo)"
    sim_ignition="$(arg sim_ignition)"
    headless_mode="$(arg headless_mode)"
    initial_positions="${xacro.load_yaml(initial_positions_file)}"
    use_tool_communication="$(arg use_tool_communication)"
    tool_voltage="$(arg tool_voltage)"
    tool_parity="$(arg tool_parity)"
    tool_baud_rate="$(arg tool_baud_rate)"
    tool_stop_bits="$(arg tool_stop_bits)"
    tool_rx_idle_chars="$(arg tool_rx_idle_chars)"
    tool_tx_idle_chars="$(arg tool_tx_idle_chars)"
    tool_device_name="$(arg tool_device_name)"
    tool_tcp_port="$(arg tool_tcp_port)"
    robot_ip="$(arg robot_ip)"
    script_filename="$(arg script_filename)"
    output_recipe_filename="$(arg output_recipe_filename)"
    input_recipe_filename="$(arg input_recipe_filename)"
    reverse_ip="$(arg reverse_ip)"
    script_command_port="$(arg script_command_port)"
    reverse_port="$(arg reverse_port)"
    script_sender_port="$(arg script_sender_port)"
    trajectory_port="$(arg trajectory_port)"
    >

    <origin xyz="0 0 0.005" rpy="0 0 0"/>
  </xacro:ur_robot>

  <link name="camera">
    <visual>
      <geometry>
        <box size="0.01 0.08 0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="camera"/>
    <origin xyz="0 0 0.01" rpy="0 -${pi/2} ${pi/2}"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="camera"/>
    <child link="camera_optical_link"/>
  </joint>

  <gazebo reference="camera">
    <material>Gazebo/Red</material>
    <sensor name="depth_camera" type="depth">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <depth_camera name="depth_cam">
        <horizontal_fov>2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </depth_camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <frame_name>camera_optical_link</frame_name>
        <camera_name>ee_camera</camera_name>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg sim_gazebo)">
    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:if value="$(arg sim_ignition)">
    <gazebo>
      <plugin filename="libign_ros2_control-system.so"
              name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
        <controller_manager_node_name>$(arg tf_prefix)controller_manager</controller_manager_node_name>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
