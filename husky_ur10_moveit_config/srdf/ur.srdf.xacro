<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">

  <!-- robot name parameter -->
  <xacro:arg name="name" default="husky_ur10"/>
  <!-- parameters -->
  <xacro:arg name="prefix" default="ur10_" />

  <xacro:include filename="$(find husky_ur10_moveit_config)/srdf/ur_macro.srdf.xacro"/>

  <xacro:ur_srdf name="$(arg name)" prefix="$(arg prefix)"/>

</robot>
